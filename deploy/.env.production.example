COMPOSE_PROJECT_NAME=sozlesme_analizi
APP_NAME=Sozlesme Analizi Sistemi
APP_VERSION=1.0.0
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

SECRET_KEY=replace-with-at-least-64-random-characters
CORS_ORIGINS=["https://your-project.vercel.app","https://app.example.com"]
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

POSTGRES_USER=contract_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=contract_analysis

MINIO_ROOT_USER=replace-with-a-strong-access-key
MINIO_ROOT_PASSWORD=replace-with-a-strong-secret-key
MINIO_BUCKET_NAME=contracts

GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ANALYSIS_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=30
MAX_OUTPUT_TOKENS=1024
ANALYSIS_MAX_OUTPUT_TOKENS=3072
TEMPERATURE=0.2
TOP_P=0.95

EMBEDDING_MODEL=BAAI/bge-m3
QDRANT_COLLECTION=contracts
LEGAL_COLLECTION=legal_documents
DEFAULT_SEARCH_MODE=hybrid
ENABLE_DEBUG_SEARCH=false
ENABLE_DEBUG_CHAT=false
ENABLE_LEGAL_SEARCH=true
ENABLE_MULTI_SOURCE_RAG=true
RERANK_ENABLED=true
ANALYSIS_RERANK_ENABLED=false
ENABLE_RAG_GUARDRAILS=true
ENABLE_GROUNDING_CHECK=true
ENABLE_CITATION_VALIDATION=true
ENABLE_HALLUCINATION_CHECK=true

MAX_UPLOAD_SIZE_MB=20
