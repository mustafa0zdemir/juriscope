APP_NAME=Sozlesme Analizi Sistemi
APP_VERSION=0.1.0
DEBUG=true

SECRET_KEY=change-this-to-a-secure-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/contract_analysis

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=contracts
MINIO_SECURE=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_OUTPUT_TOKENS=1024
TEMPERATURE=0.2
TOP_P=0.95
GEMINI_TIMEOUT_SECONDS=30

DEFAULT_SEARCH_MODE=hybrid
ENABLE_DEBUG_SEARCH=false
LEGAL_COLLECTION=legal_documents
ENABLE_LEGAL_SEARCH=true
ENABLE_MULTI_SOURCE_RAG=true
LEGAL_TOP_K=10
LEGAL_RERANK_TOP_N=5
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_INPUT_LIMIT=20
RERANK_TOP_N=5
RERANK_TIMEOUT_SECONDS=30

ENABLE_RAG_GUARDRAILS=true
ENABLE_GROUNDING_CHECK=true
ENABLE_CITATION_VALIDATION=true
ENABLE_HALLUCINATION_CHECK=true
MIN_CONTEXT_CHUNKS=1
MIN_CONTEXT_CHARACTERS=10
MIN_RETRIEVAL_SCORE=0.2
MIN_RERANK_SCORE=0.0
ENABLE_DEBUG_CHAT=false

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
